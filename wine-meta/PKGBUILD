# Maintainer: Librewish <librewish@gmail.com>
pkgname=wine-meta
pkgver=2.3
pkgrel=1
arch=('any')
url="https://wiki.archlinux.org/index.php/wine"
license=('GPL')
pkgdesc="Meta-package for WINE support"
optdepends=('q4wine: A Qt5 GUI for WINE')
package() {
	depends=(
		# Wine core
		wine
		wine-installer
		winetricks wineasio
		icoextract icoutils

		# Audio
		mpg123
		openal
		alsa-oss
		fluidsynth

		# Graphics & display
		giflib
		libpng        lib32-libpng
		libjpeg-turbo lib32-libjpeg-turbo
		gtk3          lib32-gtk3
		libva         lib32-libva

		# Vulkan & 3D
		vkd3d             lib32-vkd3d
		vulkan-icd-loader lib32-vulkan-icd-loader

		# Crypto & security
		libgpg-error lib32-libgpg-error
		libgcrypt    lib32-libgcrypt
		libldap      lib32-libldap

		# Misc libraries
		ncurses lib32-ncurses
		libxslt
		sqlite  lib32-sqlite
	)
}
